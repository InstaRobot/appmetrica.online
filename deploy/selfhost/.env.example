# appmetrica.online — self-hosted configuration.
# Copy to .env (`cp .env.example .env`), fill in the REQUIRED block, keep the file private (chmod 600 .env).
# Format: KEY=value, no spaces around "=", no quotes. Full description: README.md → Configuration reference.

# =====================================================================================================
# REQUIRED — domains (three DNS A/AAAA records pointing to this server)
# =====================================================================================================
# Dashboard, landing page and API docs.
APP_DOMAIN=analytics.example.com
# Event ingestion endpoint your apps send to: https://INGEST_DOMAIN/v1/events
INGEST_DOMAIN=i.analytics.example.com
# Read API for scripts and exports: https://API_DOMAIN/v1
API_DOMAIN=api.analytics.example.com
# E-mail for Let's Encrypt certificate notices.
ACME_EMAIL=admin@example.com

# =====================================================================================================
# REQUIRED — secrets (generate each one; never reuse values between installations)
# =====================================================================================================
# Postgres password:            openssl rand -hex 24
POSTGRES_PASSWORD=
# ClickHouse admin (migrations, backups):  openssl rand -hex 24
CLICKHOUSE_ADMIN_PASSWORD=
# ClickHouse read-write user (ingest, worker):  openssl rand -hex 24
CLICKHOUSE_RW_PASSWORD=
# ClickHouse read-only user (api):  openssl rand -hex 24
CLICKHOUSE_RO_PASSWORD=
# HMAC pepper for Read API keys, base64 of ≥ 32 random bytes:  openssl rand -base64 32
# Changing it later invalidates every sk_ key.
KEY_HASH_PEPPER=

# =====================================================================================================
# REQUIRED — build
# =====================================================================================================
# Month of the DB-IP City Lite geo database baked into the backend image (YYYY-MM):  date +%Y-%m
# DB-IP publishes a new file at the start of each month; if the build fails with 404 on the 1st, use
# the previous month. Rebuild monthly to keep country/city lookup fresh.
GEO_MONTH=2026-10

# =====================================================================================================
# OPTIONAL — notifications and monitoring
# =====================================================================================================
# Telegram bot token from @BotFather: daily digest and system alerts. The chat ID is set in the
# dashboard (Settings → Telegram). Empty = messages go to the worker log only.
TELEGRAM_BOT_TOKEN=
# healthchecks.io (or compatible) ping URL: the worker pings it every 5 minutes (dead-man switch).
HEALTHCHECKS_PING_URL=
# Free disk space on the ClickHouse volume below this percentage raises an alert (1–99).
DISK_FREE_ALERT_PCT=20

# =====================================================================================================
# OPTIONAL — ClickHouse backups to S3-compatible storage
# Enable with COMPOSE_PROFILES=backup and set BACKUP_API_URL=http://clickhouse-backup:7171
# =====================================================================================================
COMPOSE_PROFILES=
BACKUP_API_URL=
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_BUCKET=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Remote backups to keep (35 ≈ five weeks of daily incrementals + weekly full).
BACKUPS_TO_KEEP_REMOTE=35
# Incremental backup interval and full backup interval.
WATCH_INTERVAL=24h
FULL_INTERVAL=168h

# =====================================================================================================
# OPTIONAL — tuning (defaults are production-ready)
# =====================================================================================================
# Name shown by the browser when registering a passkey.
WEBAUTHN_RP_NAME=appmetrica.online
# Host ports for Caddy (change only if 80/443 are taken; Let's Encrypt needs 80 and 443 reachable).
HTTP_PORT=80
HTTPS_PORT=443
# debug | info | warn | error
LOG_LEVEL=info
# Dashboard session: absolute lifetime and idle timeout.
SESSION_TTL=720h
SESSION_IDLE_TTL=168h
# false = Read API rejects Bearer sk_ keys (the dashboard keeps working).
API_PUBLIC_BEARER_ENABLED=true
# Ingest limits: decompressed body size, events per batch, accepted lateness of offline events,
# tolerated client clock skew into the future.
INGEST_MAX_BODY_BYTES=1048576
INGEST_MAX_EVENTS=500
INGEST_LATE_WINDOW=168h
INGEST_FUTURE_TOLERANCE=10m
# false = drop events with environment=development (kill switch for debug traffic).
INGEST_ACCEPT_DEVELOPMENT=true
# Rate limits: per app (events/s + burst, over → HTTP 429) and per install (events/min + burst).
RATE_APP_EVENTS_PER_SEC=2000
RATE_APP_BURST=4000
RATE_INSTALL_PER_MIN=100
RATE_INSTALL_BURST=1000
# How often ingest reloads write keys from Postgres (revocation delay).
KEY_CACHE_REFRESH=15s
# Comma-separated worker jobs to run.
WORKER_JOBS_ENABLED=system_check,digest,close_day,deletion,session_cleanup,app_merge
