# appmetrica.online — переменные окружения.
# Локально: `cp .env.example .env` — значения ниже рабочие для `make dev` (docker-compose.dev.yml).
# Production: те же имена задаются в Dokploy (Environment каждого Application / compose-стека).
# Секреты для production генерируются командой: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Формат строго KEY=value без пробелов и кавычек (файл подключается в Makefile через include).

# =====================================================================
# Общие для всех Go-процессов (ingest, api, worker)
# =====================================================================
# production | development. В development cookie без флага Secure, логи в текстовом формате.
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# Prometheus /metrics каждого Go-процесса. Наружу не публикуется.
METRICS_LISTEN_ADDR=:9090
# Postgres (метаданные). Production: postgres://appmetrica:<пароль>@postgres:5432/appmetrica?sslmode=disable
POSTGRES_URL=postgres://appmetrica:dev_pg_password@localhost:5432/appmetrica?sslmode=disable
# Только dev: порт Postgres на хосте в docker-compose.dev.yml. Если 5432 занят — поменяй здесь и в POSTGRES_URL.
POSTGRES_HOST_PORT=5432
# ClickHouse native protocol. Production: clickhouse:9000
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=appmetrica
# Пользователь ClickHouse конкретного процесса: ingest и worker → appmetrica_rw, api → appmetrica_ro.
# Локально Makefile подставляет нужного пользователя в каждую цель run-*; значение ниже — для ingest/worker.
CLICKHOUSE_USER=appmetrica_rw
CLICKHOUSE_PASSWORD=dev_ch_rw_password
# Пользователь для `appmetrica migrate up` (DDL). Используется только процессом api при MIGRATE_ON_START=true и командой migrate.
CLICKHOUSE_MIGRATE_USER=appmetrica_admin
CLICKHOUSE_MIGRATE_PASSWORD=dev_ch_admin_password

# =====================================================================
# ingest (i.appmetrica.online)
# =====================================================================
INGEST_LISTEN_ADDR=:8081
# Локально: скачай базу командой `make geo-db` (кладёт файл в backend/.geo/). В образе: /app/geo/dbip-city-lite.mmdb
GEOIP_DB_PATH=.geo/dbip-city-lite.mmdb
# Максимальный размер распакованного тела запроса, байт
INGEST_MAX_BODY_BYTES=1048576
# Максимум событий в одном батче
INGEST_MAX_EVENTS=500
# Окно досыла офлайн-очереди: события старше отклоняются с кодом event_too_old
INGEST_LATE_WINDOW=168h
# Допуск «будущего» после коррекции часов; больше — время приёма + warning
INGEST_FUTURE_TOLERANCE=10m
# Лимит приложения: событий в секунду и burst (превышение → 429 app_rate_limited на весь батч)
RATE_APP_EVENTS_PER_SEC=2000
RATE_APP_BURST=4000
# Лимит установки: событий в минуту и burst (превышение → rejection install_rate_limited, retryable)
RATE_INSTALL_PER_MIN=100
RATE_INSTALL_BURST=1000
# Kill switch dev-трафика: false → события с environment=development отклоняются (invalid_field), production не затрагивается
INGEST_ACCEPT_DEVELOPMENT=true
# Период полной перезагрузки кэша write-ключей из Postgres
KEY_CACHE_REFRESH=15s

# =====================================================================
# api (api.appmetrica.online + /admin/v1 для дашборда)
# =====================================================================
API_LISTEN_ADDR=:8080
# Базовый URL дашборда (ссылки passkey-link, сообщения Telegram). Production: https://appmetrica.online
PUBLIC_BASE_URL=http://localhost:3000
# WebAuthn Relying Party. Production: appmetrica.online / https://appmetrica.online
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGINS=http://localhost:3000
WEBAUTHN_RP_NAME=appmetrica.online
# Абсолютное время жизни сессии и idle-таймаут
SESSION_TTL=720h
SESSION_IDLE_TTL=168h
# HMAC-перец для хэшей sk_-ключей (base64 от 32 случайных байт). Смена инвалидирует все sk_-ключи.
# Production: openssl rand -base64 32
KEY_HASH_PEPPER=ZGV2LXBlcHBlci1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=
# Выполнять goose-миграции Postgres и ClickHouse при старте api. Локально миграции запускает `make migrate-up`.
MIGRATE_ON_START=false
# Kill switch внешнего Read API: false → Bearer sk_-запросы получают 401, дашборд (cookie) работает
API_PUBLIC_BEARER_ENABLED=true

# =====================================================================
# worker
# =====================================================================
WORKER_LISTEN_ADDR=:8082
# Включённые задачи worker через запятую; исключение задачи из списка останавливает её исполнение
WORKER_JOBS_ENABLED=system_check,digest,close_day,deletion,session_cleanup
# Токен Telegram-бота (BotFather). Пусто → дайджест и алерты только пишутся в лог.
TELEGRAM_BOT_TOKEN=
# Ping URL healthchecks.io (dead-man switch). Пусто → пинг отключён.
HEALTHCHECKS_PING_URL=
# REST API clickhouse-backup. Пусто → проверка свежести бэкапа отключена (локально бэкапов нет).
BACKUP_API_URL=
# Порог свободного места на диске ClickHouse, %, ниже которого поднимается алерт disk_free
DISK_FREE_ALERT_PCT=20
# Health и метрики соседних процессов для system_check. Production: http://appmetrica-ingest:8081/health и т.д.
INGEST_HEALTH_URL=http://localhost:8081/health
API_HEALTH_URL=http://localhost:8080/health
INGEST_METRICS_URL=http://localhost:9091/metrics

# =====================================================================
# web (Next.js)
# =====================================================================
# Адрес api для rewrites /api/* и серверных запросов. ВНИМАНИЕ: rewrites фиксируются при `next build`.
# Production: http://appmetrica-api:8080
API_INTERNAL_URL=http://localhost:8080
# Публичные адреса для сниппетов интеграции и документации (фиксируются при build)
NEXT_PUBLIC_INGEST_URL=http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8080

# =====================================================================
# Инфраструктура: docker-compose.dev.yml и deploy/clickhouse/compose.yaml
# =====================================================================
# Пароль администратора ClickHouse (пользователь appmetrica_admin создаётся образом; DDL, бэкапы)
CLICKHOUSE_ADMIN_PASSWORD=dev_ch_admin_password
# Пароли пользователей appmetrica_rw и appmetrica_ro (читаются ClickHouse из users.d через from_env)
CLICKHOUSE_RW_PASSWORD=dev_ch_rw_password
CLICKHOUSE_RO_PASSWORD=dev_ch_ro_password
# Пароль Postgres (локальный контейнер; в production — managed DB Dokploy)
POSTGRES_PASSWORD=dev_pg_password

# =====================================================================
# clickhouse-backup (только production, compose-стек «clickhouse-stack» в Dokploy)
# =====================================================================
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=appmetrica-ch-backup
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=fsn1
# Пользователь ClickHouse для бэкапа (тот же администратор)
CLICKHOUSE_USERNAME=appmetrica_admin
BACKUPS_TO_KEEP_REMOTE=35
WATCH_INTERVAL=24h
FULL_INTERVAL=168h

# =====================================================================
# Локальная разработка (не используются в production)
# =====================================================================
# Write-ключ, который создаёт `make seed` для приложения «Seed iOS»; используется `make send-test-batch`
DEV_WRITE_KEY=pk_devseedkey0000000000000000000000
