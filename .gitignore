# Окружение и секреты
.env
.env.*
!.env.example

# Go
backend/bin/
backend/.geo/
backend/coverage.out
*.test
*.out

# Гео-база (скачивается при сборке/`make geo-db`)
*.mmdb
# Синтетическая тестовая база (1,7 КБ, `go run ./testdata/gen geo`) коммитится
!backend/testdata/geo/test-city.mmdb
*.mmdb.gz

# Node / Next.js
web/node_modules/
web/.next/
web/.source/
web/out/
web/next-env.d.ts
web/coverage/
web/playwright-report/
web/test-results/
web/blob-report/
web/e2e/.auth/
web/tsconfig.tsbuildinfo
web/.pnpm-store/

# Инструменты и ОС
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Скиллы Claude Code — симлинки на локальную библиотеку, в репо не храним
.claude/skills/

# Тестовые профили покрытия для scripts/coverage-gate.sh
!scripts/testdata/*.out

# Рабочий отчёт `make perf-ingest`; эталон baseline.json коммитится
backend/perf/reports/latest.json
